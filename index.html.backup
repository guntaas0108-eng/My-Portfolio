<!DOCTYPE html>
<html lang="en">
<head>
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>
  <style>
    :root { --accent: #6655f7; --accent2: #06b6d4; --accent3: #a78bfa; }
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #080812;
      color: #e2e8f0;
      font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
      overflow-x: hidden;
    }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: #0f0f1a; }
    ::-webkit-scrollbar-thumb { background: #6655f7; border-radius: 4px; }

    /* ════════════════════════════
       LOADER
    ════════════════════════════ */
    #loader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: #04040d;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      transition: opacity 0.8s ease, transform 0.8s ease;
    }
    #loader.exit {
      opacity: 0;
      transform: scale(1.04);
      pointer-events: none;
    }

    /* Matrix rain canvas */
    #matrix-canvas {
      position: absolute;
      inset: 0;
      opacity: 0.18;
    }

    /* Scanline sweep */
    .scan-line {
      position: absolute;
      left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, rgba(6,182,212,0.6) 40%, rgba(102,85,247,0.8) 60%, transparent 100%);
      animation: scanSweep 2.8s ease-in-out infinite;
      top: 0;
      box-shadow: 0 0 18px rgba(102,85,247,0.7);
      z-index: 2;
    }
    @keyframes scanSweep {
      0%   { top: 0%;   opacity: 0; }
      5%   { opacity: 1; }
      95%  { opacity: 1; }
      100% { top: 100%; opacity: 0; }
    }

    /* Scanline overlay texture */
    .scanlines {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0,0,0,0.25) 2px,
        rgba(0,0,0,0.25) 4px
      );
      pointer-events: none;
      z-index: 1;
    }

    /* Orbital rings */
    .orb-wrap {
      position: relative;
      width: 220px;
      height: 220px;
      margin-bottom: 40px;
      z-index: 3;
    }
    .orb-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 1.5px solid transparent;
    }
    .orb-ring-1 {
      border-top-color: #6655f7;
      border-right-color: rgba(102,85,247,0.3);
      animation: spin1 1.6s linear infinite;
      box-shadow: 0 0 16px rgba(102,85,247,0.4);
    }
    .orb-ring-2 {
      inset: 18px;
      border-bottom-color: #06b6d4;
      border-left-color: rgba(6,182,212,0.3);
      animation: spin1 1.1s linear infinite reverse;
      box-shadow: 0 0 12px rgba(6,182,212,0.3);
    }
    .orb-ring-3 {
      inset: 36px;
      border-top-color: #a78bfa;
      border-right-color: rgba(167,139,250,0.2);
      animation: spin1 2.2s linear infinite;
    }
    @keyframes spin1 { to { transform: rotate(360deg); } }

    /* Center of orb */
    .orb-center {
      position: absolute;
      inset: 54px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(102,85,247,0.25) 0%, rgba(6,182,212,0.1) 60%, transparent 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(102,85,247,0.25);
    }
    .orb-percent {
      font-family: 'Courier New', monospace;
      font-size: 18px;
      font-weight: 700;
      color: #a78bfa;
    }

    /* Loader name glitch */
    .loader-name {
      z-index: 3;
      text-align: center;
      margin-bottom: 28px;
    }
    .loader-name-text {
      font-size: clamp(28px, 5vw, 48px);
      font-weight: 900;
      letter-spacing: 8px;
      text-transform: uppercase;
      font-family: 'Inter', monospace;
      position: relative;
      display: inline-block;
    }
    .loader-name-text .w1 { color: #6655f7; text-shadow: 0 0 20px rgba(102,85,247,0.6); }
    .loader-name-text .w2 { color: #06b6d4; text-shadow: 0 0 20px rgba(6,182,212,0.5); }

    .glitch-char {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      animation: revealChar 0.05s forwards;
    }
    @keyframes revealChar {
      to { opacity: 1; transform: translateY(0); }
    }

    /* Progress bar */
    .loader-bar-wrap {
      z-index: 3;
      width: 280px;
      height: 2px;
      background: rgba(255,255,255,0.06);
      border-radius: 999px;
      overflow: hidden;
      position: relative;
    }
    .loader-bar-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #6655f7, #06b6d4);
      border-radius: 999px;
      transition: width 0.05s linear;
      box-shadow: 0 0 10px rgba(102,85,247,0.7);
      position: relative;
    }
    .loader-bar-fill::after {
      content: '';
      position: absolute;
      right: 0;
      top: -3px;
      width: 6px;
      height: 8px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 8px #06b6d4, 0 0 16px rgba(102,85,247,0.8);
    }

    /* Status text */
    .loader-status {
      z-index: 3;
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #475569;
      font-family: 'Courier New', monospace;
      margin-top: 14px;
    }

    /* Corner decorations */
    .corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border-color: rgba(102,85,247,0.4);
      border-style: solid;
      z-index: 3;
    }
    .corner-tl { top: 24px; left: 24px; border-width: 2px 0 0 2px; }
    .corner-tr { top: 24px; right: 24px; border-width: 2px 2px 0 0; }
    .corner-bl { bottom: 24px; left: 24px; border-width: 0 0 2px 2px; }
    .corner-br { bottom: 24px; right: 24px; border-width: 0 2px 2px 0; }

    /* HUD lines */
    .hud-line-h {
      position: absolute;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(102,85,247,0.2), transparent);
      z-index: 2;
    }
    .hud-line-v {
      position: absolute;
      width: 1px;
      background: linear-gradient(180deg, transparent, rgba(102,85,247,0.15), transparent);
      z-index: 2;
    }

    /* ════════════════════════════
       NAVBAR
    ════════════════════════════ */
    nav {
      position: fixed;
      top: 0; left: 50%;
      transform: translateX(-50%);
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 6px;
      background: rgba(8,8,18,0.8);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(102,85,247,0.2);
      border-radius: 999px;
      padding: 10px 20px;
      margin-top: 18px;
    }
    nav a {
      color: #94a3b8;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      padding: 5px 12px;
      border-radius: 999px;
      transition: all 0.2s;
      cursor: pointer;
    }
    nav a:hover { color: #fff; background: rgba(102,85,247,0.2); }
    nav a.active { color: #fff; background: #6655f7; }

    /* ════════════════════════════
       HERO
    ════════════════════════════ */
    .hero-name-wrap {
      text-align: center;
      padding: 20px 0 8px;
      position: relative;
    }
    .hero-greeting {
      font-size: 14px;
      color: #475569;
      letter-spacing: 4px;
      text-transform: uppercase;
      font-weight: 500;
      margin-bottom: 10px;
    }
    .hero-big-name {
      font-size: clamp(52px, 9vw, 100px);
      font-weight: 900;
      line-height: 0.92;
      letter-spacing: -2px;
      display: inline-block;
      position: relative;
    }
    .hero-big-name .part-1 {
      color: #6655f7;
      text-shadow:
        0 0 40px rgba(102,85,247,0.35),
        0 0 80px rgba(102,85,247,0.12);
    }
    .hero-big-name .part-2 {
      color: #06b6d4;
      text-shadow:
        0 0 40px rgba(6,182,212,0.35),
        0 0 80px rgba(6,182,212,0.12);
    }

    /* Subtle shimmer scan over the name */
    .hero-big-name::after {
      content: '';
      position: absolute;
      top: 0; left: -80%;
      width: 60%;
      height: 100%;
      background: linear-gradient(105deg, transparent 30%, rgba(255,255,255,0.06) 50%, transparent 70%);
      animation: shimmer 3.5s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes shimmer {
      0%   { left: -80%; }
      100% { left: 140%; }
    }

    /* Underline glow */
    .name-glow-line {
      width: 80%;
      max-width: 500px;
      height: 1px;
      margin: 12px auto 0;
      background: linear-gradient(90deg, transparent, #6655f7 30%, #06b6d4 70%, transparent);
      opacity: 0.5;
    }

    /* WarpText area below name */
    #warp-canvas-wrap {
      position: relative;
      height: 60px;
      width: 100%;
      max-width: 700px;
      margin: 0 auto;
    }
    #warp-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }

    /* ════════════════════════════
       SHARED STYLES
    ════════════════════════════ */
    section { padding: 80px 0; }
    .section-label {
      font-size: 12px; font-weight: 600; letter-spacing: 3px;
      text-transform: uppercase; color: var(--accent); margin-bottom: 10px;
    }
    h2.section-title {
      font-size: clamp(28px,4vw,42px); font-weight: 800; line-height: 1.1; margin: 0 0 10px;
    }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
    .grad { background: linear-gradient(135deg, #6655f7, #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

    .avail-pill {
      display: inline-flex; align-items: center; gap: 7px;
      background: rgba(6,182,212,0.1); border: 1px solid rgba(6,182,212,0.3);
      padding: 5px 14px; border-radius: 999px; font-size: 12px; font-weight: 600;
      color: #06b6d4; letter-spacing: 0.5px;
    }
    .avail-dot {
      width: 7px; height: 7px; border-radius: 50%; background: #06b6d4;
      animation: ping 1.5s ease-in-out infinite;
    }
    @keyframes ping { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(1.4)} }

    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 24px; border-radius: 10px; font-size: 14px; font-weight: 600;
      cursor: pointer; border: none; transition: all 0.25s; text-decoration: none;
    }
    .btn-primary { background: #6655f7; color: white; }
    .btn-primary:hover { background: #5544e0; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(102,85,247,0.4); }
    .btn-secondary { background: transparent; color: #e2e8f0; border: 1px solid rgba(255,255,255,0.15); }
    .btn-secondary:hover { background: rgba(255,255,255,0.06); transform: translateY(-2px); }

    /* Terminal */
    .terminal { background: #0d0d1a; border: 1px solid rgba(102,85,247,0.25); border-radius: 14px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.6); }
    .terminal-header { background: #141424; padding: 12px 16px; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .t-dot { width: 12px; height: 12px; border-radius: 50%; }
    .terminal-body { padding: 20px; font-family: 'Courier New', monospace; font-size: 13px; min-height: 200px; }
    .t-line { display: flex; gap: 8px; margin-bottom: 6px; line-height: 1.6; }
    .t-prompt { color: #6655f7; }
    .t-out { color: #94a3b8; padding-left: 16px; margin-bottom: 10px; }
    .t-cursor { display: inline-block; width: 8px; height: 14px; background: #6655f7; animation: blink 1.1s step-end infinite; vertical-align: middle; }
    @keyframes blink { 50%{opacity:0} }

    /* Marquee */
    .marquee-wrapper { overflow: hidden; position: relative; }
    .marquee-wrapper::before, .marquee-wrapper::after { content:''; position:absolute; top:0; bottom:0; width:80px; z-index:2; }
    .marquee-wrapper::before { left:0; background:linear-gradient(to right,#080812,transparent); }
    .marquee-wrapper::after { right:0; background:linear-gradient(to left,#080812,transparent); }
    .marquee-track { display:flex; gap:16px; animation:marquee 28s linear infinite; width:max-content; }
    .marquee-track:hover { animation-play-state:paused; }
    @keyframes marquee { to{transform:translateX(-50%)} }
    .skill-badge {
      display:flex; align-items:center; gap:8px; padding:8px 18px;
      border:1px solid rgba(102,85,247,0.2); border-radius:999px;
      background:rgba(102,85,247,0.05); font-size:13px; font-weight:500;
      white-space:nowrap; color:#cbd5e1; transition:all 0.2s;
    }
    .skill-badge:hover { border-color:#6655f7; color:#fff; background:rgba(102,85,247,0.12); }

    /* Bento */
    .bento { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; }
    .bento-card {
      background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07);
      border-radius:18px; padding:24px; transition:all 0.3s;
      position:relative; overflow:hidden;
    }
    .bento-card::before {
      content:''; position:absolute; inset:0;
      background:radial-gradient(400px circle at var(--mx,50%) var(--my,50%),rgba(102,85,247,0.08),transparent 60%);
      opacity:0; transition:opacity 0.3s;
    }
    .bento-card:hover::before { opacity:1; }
    .bento-card:hover { border-color:rgba(102,85,247,0.3); transform:translateY(-2px); }
    .bento-wide { grid-column:span 2; }

    /* Projects */
    .project-card {
      border:1px solid rgba(255,255,255,0.07); border-radius:18px;
      background:rgba(255,255,255,0.02); overflow:hidden; transition:all 0.3s; cursor:pointer;
    }
    .project-card:hover { border-color:rgba(102,85,247,0.4); transform:translateY(-4px); box-shadow:0 20px 50px rgba(102,85,247,0.15); }
    .project-preview { height:160px; display:flex; align-items:center; justify-content:center; font-size:40px; position:relative; overflow:hidden; }
    .project-card-body { padding:20px; }
    .project-tag { display:inline-flex; align-items:center; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:600; margin-right:6px; margin-bottom:6px; }

    /* Tabs */
    .tab-bar { display:flex; gap:6px; margin-bottom:28px; }
    .tab { padding:8px 18px; border-radius:999px; font-size:13px; font-weight:600; cursor:pointer; border:1px solid transparent; transition:all 0.2s; color:#64748b; }
    .tab.active { background:rgba(102,85,247,0.15); border-color:rgba(102,85,247,0.4); color:#a78bfa; }
    .tab:hover:not(.active) { color:#94a3b8; border-color:rgba(255,255,255,0.1); }

    /* Achievement */
    .ach-card { background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.07); border-radius:16px; padding:24px; transition:all 0.3s; display:flex; gap:16px; align-items:flex-start; }
    .ach-card:hover { border-color:rgba(102,85,247,0.3); background:rgba(102,85,247,0.05); }
    .ach-icon { width:44px; height:44px; border-radius:12px; background:rgba(102,85,247,0.15); border:1px solid rgba(102,85,247,0.25); display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }

    /* Timeline */
    .timeline-item { display:flex; gap:20px; padding-bottom:36px; }
    .timeline-left { display:flex; flex-direction:column; align-items:center; }
    .timeline-dot { width:14px; height:14px; border-radius:50%; background:#6655f7; box-shadow:0 0 12px rgba(102,85,247,0.7); flex-shrink:0; margin-top:4px; }
    .timeline-line { width:2px; flex:1; background:linear-gradient(to bottom,rgba(102,85,247,0.5),transparent); margin-top:6px; }
    .timeline-content { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07); border-radius:14px; padding:20px; flex:1; }

    /* Contact */
    .contact-glass { background:rgba(102,85,247,0.05); border:1px solid rgba(102,85,247,0.2); border-radius:24px; padding:48px; text-align:center; position:relative; overflow:hidden; }
    .contact-glass::before { content:''; position:absolute; width:300px; height:300px; border-radius:50%; background:radial-gradient(circle,rgba(102,85,247,0.12),transparent 70%); top:-80px; left:50%; transform:translateX(-50%); }

    .social-pill { display:inline-flex; align-items:center; gap:8px; padding:8px 18px; border:1px solid rgba(255,255,255,0.1); border-radius:999px; font-size:13px; font-weight:500; color:#94a3b8; cursor:pointer; text-decoration:none; transition:all 0.2s; margin:0 4px; }
    .social-pill:hover { border-color:#6655f7; color:#fff; background:rgba(102,85,247,0.12); }

    footer { border-top:1px solid rgba(255,255,255,0.06); padding:32px 0; text-align:center; color:#475569; font-size:13px; }
    .logo-text { font-size:22px; font-weight:800; color:#fff; }
    .logo-text span { color:#6655f7; }

    /* Reveal */
    .reveal { opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; }
    .reveal.visible { opacity:1; transform:none; }

    /* Cursor glow */
    .cursor-glow { pointer-events:none; position:fixed; z-index:9999; width:400px; height:400px; border-radius:50%; background:radial-gradient(circle,rgba(102,85,247,0.07) 0%,transparent 70%); transform:translate(-50%,-50%); transition:left 0.1s,top 0.1s; }

    #bg-canvas { position:fixed; inset:0; pointer-events:none; z-index:0; opacity:0.6; }
    .content-wrap { position:relative; z-index:1; }
  </style>
</head>
<body>

<!-- ═══════════════════════════════════════
     HOLOGRAPHIC LOADER
═══════════════════════════════════════ -->
<div id="loader">
  <canvas id="matrix-canvas"></canvas>
  <div class="scanlines"></div>
  <div class="scan-line"></div>

  <!-- Corner HUD brackets -->
  <div class="corner corner-tl"></div>
  <div class="corner corner-tr"></div>
  <div class="corner corner-bl"></div>
  <div class="corner corner-br"></div>

  <!-- HUD lines -->
  <div class="hud-line-h" style="top:30%;left:0;right:0;"></div>
  <div class="hud-line-h" style="bottom:28%;left:0;right:0;"></div>
  <div class="hud-line-v" style="left:12%;top:0;bottom:0;height:100%;"></div>
  <div class="hud-line-v" style="right:12%;top:0;bottom:0;height:100%;"></div>

  <!-- Orbital rings -->
  <div class="orb-wrap">
    <div class="orb-ring orb-ring-1"></div>
    <div class="orb-ring orb-ring-2"></div>
    <div class="orb-ring orb-ring-3"></div>
    <div class="orb-center">
      <span class="orb-percent" id="orb-pct">0%</span>
    </div>
  </div>

  <!-- Glitch name reveal -->
  <div class="loader-name">
    <div class="loader-name-text" id="loader-name-el">
      <span class="w1" id="loader-w1"></span><span style="color:#475569;"> </span><span class="w2" id="loader-w2"></span>
    </div>
    <div style="width:100%;height:1px;background:linear-gradient(90deg,transparent,rgba(102,85,247,0.5),rgba(6,182,212,0.5),transparent);margin-top:8px;"></div>
  </div>

  <!-- Progress bar -->
  <div class="loader-bar-wrap">
    <div class="loader-bar-fill" id="loader-bar"></div>
  </div>

  <!-- Status -->
  <div class="loader-status" id="loader-status">INITIALIZING SYSTEM...</div>
</div>


<!-- ═══════════════════════════════════════
     SITE
═══════════════════════════════════════ -->
<div class="cursor-glow" id="cursorGlow"></div>
<canvas id="bg-canvas"></canvas>

<div class="content-wrap" id="site-content" style="display:none;">

  <!-- Floating Nav -->
  <nav id="mainNav">
    <a class="active" onclick="scrollTo('home')">Home</a>
    <a onclick="scrollTo('about')">About</a>
    <a onclick="scrollTo('skills')">Skills</a>
    <a onclick="scrollTo('projects')">Projects</a>
    <a onclick="scrollTo('contact')">Contact</a>
    <a style="background:#6655f7;color:#fff;margin-left:8px;" onclick="alert('Resume would open here')">Resume ↗</a>
  </nav>

  <!-- ═══ HERO ═══ -->
  <section id="home" style="min-height:100vh; display:flex; align-items:center; padding-top:90px;">
    <div class="container" style="width:100%;">

      <!-- BIG CENTERED NAME AT TOP -->
      <div class="hero-name-wrap">
        <p class="hero-greeting">Hi, I'm</p>
        <div class="hero-big-name">
          <span class="part-1">Guntaas</span><span style="color:#2d2d5e;"> </span><span class="part-2">Singh</span>
        </div>
        <div class="name-glow-line"></div>

        <!-- Subtitle shimmer line (warp canvas effect area) -->
        <div id="warp-canvas-wrap" style="height:36px;">
          <canvas id="warp-canvas"></canvas>
        </div>
      </div>

      <!-- Content below name -->
      <div style="display:grid; grid-template-columns:1.1fr 0.9fr; gap:60px; align-items:start; margin-top:40px;">

        <!-- Left -->
        <div>
          <div class="avail-pill" style="margin-bottom:18px;">
            <div class="avail-dot"></div>
            Available for Internships &amp; Collaborations
          </div>

          <p style="font-size:14px; color:#64748b; letter-spacing:3px; text-transform:uppercase; font-weight:600; margin-bottom:14px;">COMPUTER SCIENCE STUDENT • DEVELOPER</p>

          <h2 style="font-size:clamp(20px,3vw,30px); color:#64748b; font-weight:600; margin:0 0 18px;">
            Building ideas into
            <span class="grad">digital experiences.</span>
          </h2>

          <p style="color:#64748b; font-size:15px; line-height:1.7; max-width:480px; margin-bottom:32px;">
            CS student at <strong style="color:#a78bfa;">Thapar Institute of Engineering & Technology</strong>, 
            passionate about software development, problem solving, and building meaningful technology.
          </p>

