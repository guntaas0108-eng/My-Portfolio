<script>
// ══════════════════════════════════════════════
// LOADER
// ══════════════════════════════════════════════
(function() {
  // Matrix rain
  const mc = document.getElementById('matrix-canvas');
  const mx = mc.getContext('2d');
  mc.width = window.innerWidth;
  mc.height = window.innerHeight;

  const chars = 'GUNTAASSINGH01アイウエオカキクケコサシスセソタチツテトナニヌネノ0110'.split('');
  const col = Math.floor(mc.width / 14);
  const drops = Array(col).fill(1);

  function rainDrop() {
    mx.fillStyle = 'rgba(4,4,13,0.05)';
    mx.fillRect(0, 0, mc.width, mc.height);
    drops.forEach((y, i) => {
      const ch = chars[Math.floor(Math.random() * chars.length)];
      const x = i * 14;
      const isDual = Math.random() > 0.7;
      mx.fillStyle = isDual ? `rgba(6,182,212,${Math.random()*0.7+0.2})` : `rgba(102,85,247,${Math.random()*0.6+0.15})`;
      mx.font = '13px monospace';
      mx.fillText(ch, x, y * 14);
      if (y * 14 > mc.height && Math.random() > 0.975) drops[i] = 0;
      drops[i]++;
    });
  }
  const matrixInterval = setInterval(rainDrop, 40);

  // Name reveal letter by letter
  const name1 = 'GUNTAAS';
  const name2 = 'SINGH';
  const w1El = document.getElementById('loader-w1');
  const w2El = document.getElementById('loader-w2');
  let charIdx = 0;
  const allChars = name1.split('').map(c => ({c, part: 1}))
    .concat([{c:' ',part:0}])
    .concat(name2.split('').map(c => ({c, part: 2})));

  function revealNextChar() {
    if (charIdx >= allChars.length) return;
    const item = allChars[charIdx];
    const span = document.createElement('span');
    span.textContent = item.c;
    // Glitch: briefly show random char, then settle
    let glitchCount = 0;
    const glitchChars = '▓▒░█▌▐01'.split('');
    const gi = setInterval(() => {
      span.textContent = glitchChars[Math.floor(Math.random() * glitchChars.length)];
      glitchCount++;
      if (glitchCount > 3) {
        clearInterval(gi);
        span.textContent = item.c;
      }
    }, 35);
    if (item.part === 1) w1El.appendChild(span);
    else if (item.part === 2) w2El.appendChild(span);
    charIdx++;
    setTimeout(revealNextChar, 80);
  }
  setTimeout(revealNextChar, 300);

  // Progress bar
  const bar = document.getElementById('loader-bar');
  const pct = document.getElementById('orb-pct');
  const statusEl = document.getElementById('loader-status');
  const statuses = [
    'INITIALIZING SYSTEM...',
    'LOADING CORE MODULES...',
    'COMPILING ASSETS...',
    'ESTABLISHING CONNECTION...',
    'RENDERING INTERFACE...',
    'ACCESS GRANTED ✓'
  ];
  let progress = 0;
  const interval = setInterval(() => {
    progress = Math.min(100, progress + (Math.random() * 2.2 + 0.6));
    bar.style.width = progress + '%';
    pct.textContent = Math.floor(progress) + '%';
    const si = Math.floor((progress / 100) * (statuses.length - 1));
    statusEl.textContent = statuses[Math.min(si, statuses.length - 1)];

    if (progress >= 100) {
      clearInterval(interval);
      clearInterval(matrixInterval);
      setTimeout(() => {
        const loader = document.getElementById('loader');
        loader.classList.add('exit');
        setTimeout(() => {
          loader.style.display = 'none';
          document.body.style.overflow = 'auto';
          document.getElementById('site-content').style.display = 'block';
          initSite();
        }, 850);
      }, 500);
    }
  }, 40);
})();


// ══════════════════════════════════════════════
// SITE INIT (after loader finishes)
// ══════════════════════════════════════════════
function initSite() {
  // Cursor glow
  const glow = document.getElementById('cursorGlow');
  document.addEventListener('mousemove', e => {
    glow.style.left = e.clientX + 'px';
    glow.style.top = e.clientY + 'px';
  });

  // Bento hover glow
  document.querySelectorAll('.bento-card').forEach(card => {
    card.addEventListener('mousemove', e => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', ((e.clientX-r.left)/r.width*100).toFixed(1)+'%');
      card.style.setProperty('--my', ((e.clientY-r.top)/r.height*100).toFixed(1)+'%');
    });
  });

  // Particle BG
  const bgC = document.getElementById('bg-canvas');
  const bgX = bgC.getContext('2d');
  bgC.width = window.innerWidth;
  bgC.height = window.innerHeight;
  window.addEventListener('resize', () => { bgC.width = window.innerWidth; bgC.height = window.innerHeight; });

  const pts = Array.from({length:55}, () => ({
    x: Math.random()*window.innerWidth,
    y: Math.random()*window.innerHeight,
    r: Math.random()*1.5+0.4,
    dx: (Math.random()-0.5)*0.3,
    dy: (Math.random()-0.5)*0.3,
    a: Math.random()*0.4+0.15
  }));

  (function animBg() {
    bgX.clearRect(0,0,bgC.width,bgC.height);
    pts.forEach(p => {
      p.x+=p.dx; p.y+=p.dy;
      if(p.x<0||p.x>bgC.width) p.dx*=-1;
      if(p.y<0||p.y>bgC.height) p.dy*=-1;
      bgX.beginPath();
      bgX.arc(p.x,p.y,p.r,0,Math.PI*2);
      bgX.fillStyle=`rgba(102,85,247,${p.a})`;
      bgX.fill();
    });
    pts.forEach((a,i) => pts.slice(i+1).forEach(b => {
      const d=Math.hypot(a.x-b.x,a.y-b.y);
      if(d<130){bgX.beginPath();bgX.moveTo(a.x,a.y);bgX.lineTo(b.x,b.y);bgX.strokeStyle=`rgba(102,85,247,${0.1*(1-d/130)})`;bgX.lineWidth=0.5;bgX.stroke();}
    }));
    requestAnimationFrame(animBg);
  })();

  // Warp canvas — subtitle shimmer
  const wc = document.getElementById('warp-canvas');
  const wx = wc.getContext('2d');
  function resizeW() {
    const wrap = document.getElementById('warp-canvas-wrap');
    wc.width = wrap.offsetWidth;
    wc.height = wrap.offsetHeight;
  }
  resizeW();
  window.addEventListener('resize', resizeW);
  let wt = 0;
  (function warpLoop() {
    wt += 0.012;
    wx.clearRect(0,0,wc.width,wc.height);
    const text = 'Building ideas into digital experiences.';
    const fs = Math.min(wc.width*0.035, 15);
    wx.font = `500 ${fs}px Inter, sans-serif`;
    wx.textAlign = 'center';
    wx.textBaseline = 'middle';
    // Sweeping gradient text
    const grad = wx.createLinearGradient(
      wc.width*(0.3+Math.sin(wt*0.5)*0.2),0,
      wc.width*(0.7+Math.cos(wt*0.4)*0.2),0
    );
    grad.addColorStop(0,'rgba(102,85,247,0.7)');
    grad.addColorStop(0.5,'rgba(167,139,250,0.9)');
    grad.addColorStop(1,'rgba(6,182,212,0.7)');
    wx.fillStyle = grad;
    wx.fillText(text, wc.width/2, wc.height/2);
    requestAnimationFrame(warpLoop);
  })();

  // Terminal
  const terminalBody = document.getElementById('terminal-body');
  let termLines = [];
  const cmdMap = {
    whoami: ['guntaas-singh'],
    education: ['Computer Science @ TIET'],
    status: ['Building & Learning 🚀'],
    passion: ['Code • Create • Solve'],
    skills: ['Languages: C++, C, Python, JavaScript, HTML, CSS','Tools: Git, GitHub, VS Code, PostgreSQL, Linux'],
    projects: ['→ Developer Portfolio (HTML/CSS/JS)','→ Project Two (C++/DSA)','→ Project Three (Python/PostgreSQL)'],
    contact: ['📧 your-email@example.com','💼 linkedin.com/in/guntaas','⭐ github.com/guntaas'],
    help: ['Commands: whoami, education, status, passion, skills, projects, contact, clear'],
  };
  function renderTerminal() {
    terminalBody.innerHTML = termLines.map(l =>
      l.type==='cmd'
        ? `<div class="t-line"><span class="t-prompt">$</span><span style="color:#e2e8f0;margin-left:6px;">${l.text}</span></div>`
        : `<div class="t-out">${l.text}</div>`
    ).join('') + `<div class="t-line"><span class="t-prompt">$</span><span class="t-cursor" style="margin-left:6px;"></span></div>`;
    terminalBody.scrollTop = terminalBody.scrollHeight;
  }
  window.runCmd = cmd => {
    if(cmd==='clear'){termLines=[];renderTerminal();return;}
    termLines.push({type:'cmd',text:cmd});
    (cmdMap[cmd]||[`command not found: ${cmd}`]).forEach(l=>termLines.push({type:'out',text:l}));
    if(termLines.length>28) termLines=termLines.slice(-22);
    renderTerminal();
  };
  let bi=0;
  const boot=['whoami','education','status','passion'];
  (function bt(){if(bi<boot.length){runCmd(boot[bi++]);setTimeout(bt,700);}})();

  // Marquee
  const s1=[{i:'⚡',n:'C++'},{i:'🔧',n:'C'},{i:'🐍',n:'Python'},{i:'🌐',n:'JavaScript'},{i:'📄',n:'HTML'},{i:'🎨',n:'CSS'},{i:'🗃️',n:'PostgreSQL'},{i:'🐙',n:'Git / GitHub'},{i:'🐧',n:'Linux'},{i:'💻',n:'VS Code'}];
  const s2=[{i:'🔢',n:'Data Structures'},{i:'🧠',n:'Algorithms'},{i:'🗄️',n:'Databases'},{i:'🔍',n:'Problem Solving'},{i:'🌐',n:'Web Dev'},{i:'🧩',n:'OOP'},{i:'📦',n:'REST APIs'},{i:'🖥️',n:'OS Concepts'},{i:'🔒',n:'Security Basics'},{i:'🚀',n:'Full Stack'}];
  function buildM(id,items){
    const t=document.getElementById(id);
    t.innerHTML=[...items,...items].map(s=>`<div class="skill-badge"><span>${s.i}</span><span>${s.n}</span></div>`).join('');
  }
  buildM('marquee1',s1);
  buildM('marquee2',s2);

  // Project filter
  window.filterProjects=(cat,el)=>{
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    el.classList.add('active');
    document.querySelectorAll('.project-card').forEach(c=>{
      const show=cat==='all'||c.dataset.cat===cat;
      c.style.opacity='0';
      c.style.display=show?'block':'none';
      if(show)setTimeout(()=>{c.style.transition='opacity 0.3s';c.style.opacity='1';},20);
    });
  };

  // Scroll reveal
  const obs=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');}),{threshold:0.1});
  document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

  // Copy email
  window.copyEmail=()=>{
    navigator.clipboard.writeText('your-email@example.com').catch(()=>{});
    const t=document.getElementById('copy-toast');
    t.style.display='block';
    setTimeout(()=>t.style.display='none',2500);
  };

  // Scroll
  window.scrollTo=id=>document.getElementById(id)?.scrollIntoView({behavior:'smooth'});
}
</script>
</body>
</html>
